{
  "name": "cvforge",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "postinstall": "node scripts/copy-pdfjs.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch",
    "test:ci": "jest --ci",
    "audit": "npm audit",
    "audit:prod": "npm audit --omit=dev",
    "verify": "npm run lint && npm run typecheck && npm run test:ci && npm run build && npm run audit:prod",
    "build:cli": "tsc -p tsconfig.cli.json",
    "ats-score": "npm run build:cli --silent && node scripts/run-ats-score.cjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "@react-pdf/renderer": "^4.3.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@vercel/analytics": "^1.0.1",
    "next": "^16.2.5",
    "pdfjs": "^2.5.0",
    "pdfjs-dist": "^5.4.530",
    "react": "^19.2.6",
    "react-contenteditable": "^3.3.7",
    "react-dom": "^19.2.6",
    "react-frame-component": "^5.2.6",
    "react-redux": "^9.2.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.14",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.1.6"
  },
  "overrides": {
    "postcss": "^8.5.14"
  }
}
